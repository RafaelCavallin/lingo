# Fase 2 — necessárias apenas para geração automática e voz neural.
# Sem elas o app continua funcionando: cadastro manual + voz do navegador.

# Provedor da geração automática (tradução/dicas): anthropic (padrão) ou gemini.
# Trocar de provedor é só mudar esta variável e preencher a chave correspondente abaixo.
ENRICH_PROVIDER=
# Lida quando ENRICH_PROVIDER=anthropic (ou vazio).
ANTHROPIC_API_KEY=
# Lida quando ENRICH_PROVIDER=gemini.
GEMINI_API_KEY=
# Opcional: sobrepõe o modelo padrão do provedor ativo
# (claude-haiku-4-5-20251001 / gemini-flash-latest).
ENRICH_MODEL=
OPENAI_API_KEY=
# Vozes en-US: nova, alloy, shimmer, onyx
TTS_VOICE=
TTS_MODEL=

# Fase 5 — contas e sincronização via Supabase (Postgres + RLS).
# Públicas por design: vão para o bundle do cliente. Nunca coloque aqui a
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
